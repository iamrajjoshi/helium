+BrowserWindowInterface* OpenLittleArc(Profile* profile,
+                                     const GURL& url,
+                                     bool is_untrusted_launch) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumLittleArc) || !profile ||
+      !url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+      base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kKioskMode) ||
+      GetBrowserWindowCreationStatusForProfile(*profile) !=
+          BrowserWindowInterface::CreationStatus::kOk) {
+    return nullptr;
+  }
+
+  BrowserWindowCreateParams create_params(
+      BrowserWindowInterface::TYPE_POPUP, *profile, true);
+  create_params.initial_bounds = gfx::Rect(720, 640);
+  create_params.initial_origin_specified =
+      BrowserWindowCreateParams::ValueSpecified::kUnspecified;
+  create_params.initial_show_state = ui::mojom::WindowShowState::kNormal;
+  create_params.omit_from_session_restore = true;
+  create_params.should_trigger_session_restore = false;
+  create_params.user_title = "Little Arc";
+  BrowserWindowInterface* popup = CreateBrowserWindow(std::move(create_params));
+  if (!popup) {
+    return nullptr;
+  }
+
+  base::WeakPtr<BrowserWindowInterface> popup_weak = popup->GetWeakPtr();
+  if (!popup_weak || popup_weak->IsDeleteScheduled()) {
+    return nullptr;
+  }
+  NavigateParams navigation(popup, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  // CURRENT_TAB targets this empty popup rather than selecting a normal window.
+  navigation.disposition = WindowOpenDisposition::CURRENT_TAB;
+  if (is_untrusted_launch) {
+    navigation.initiator_origin = url::Origin();
+  }
+  Navigate(&navigation);
+  // Navigation and native window callbacks can close a window synchronously.
+  // A weak pointer can still be live after deletion has been scheduled.
+  if (!popup_weak || popup_weak->IsDeleteScheduled()) {
+    return nullptr;
+  }
+  content::WebContents* contents =
+      popup_weak->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) {
+    popup_weak->GetWindow()->Close();
+    return nullptr;
+  }
+  contents->SetUserData(kLittleArcContentsKey,
+                        std::make_unique<LittleArcContentsData>());
+  popup_weak->GetWindow()->Show();
+  return popup_weak && !popup_weak->IsDeleteScheduled() ? popup_weak.get()
+                                                       : nullptr;
+}
