+class AppControllerLittleArcBrowserTest : public InProcessBrowserTest {
+ public:
+  AppControllerLittleArcBrowserTest() {
+    feature_list_.InitAndEnableFeature(features::kHeliumLittleArc);
+  }
+
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(embedded_test_server()->Start());
