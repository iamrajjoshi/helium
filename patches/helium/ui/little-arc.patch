+IN_PROC_BROWSER_TEST_F(LittleArcBrowserTest, PromotionPreservesPageAndProfile) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  BrowserWindowInterface* popup =
+      OpenLittleArc(browser()->GetProfile(), url, false);
+  ASSERT_TRUE(popup);
+  EXPECT_EQ(BrowserWindowInterface::TYPE_POPUP, popup->GetType());
+  EXPECT_EQ(browser()->GetProfile(), popup->GetProfile());
+  EXPECT_TRUE(BrowserInitState::From(popup)
+                  ->create_params()
+                  .omit_from_session_restore);
+  EXPECT_FALSE(BrowserInitState::From(popup)
+                   ->create_params()
+                   .should_trigger_session_restore);
+  content::WebContents* contents =
+      popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(url, contents->GetLastCommittedURL());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      popup, embedded_test_server()->GetURL("/title2.html")));
+  ASSERT_TRUE(content::ExecJs(contents,
+      "window.littleArcState = 'retained';"
+      "document.cookie = 'little_arc_cookie=present; path=/';"));
+  const int history_count = contents->GetController().GetEntryCount();
+
+  // The preview shares the resolved profile's cookies, not a fresh profile.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  EXPECT_EQ(true, content::EvalJs(
+      browser()->GetTabStripModel()->GetActiveWebContents(),
+      "document.cookie.includes('little_arc_cookie=present')"));
+  const int target_count = browser()->GetTabStripModel()->count();
+  BrowserCommandsTest::ReloadObserver reload_observer;
+  reload_observer.SetWebContents(contents);
+  ConvertPopupToTabbedBrowser(popup);
+  EXPECT_EQ(target_count + 1, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_EQ("retained", content::EvalJs(contents, "window.littleArcState"));
+  EXPECT_EQ(history_count, contents->GetController().GetEntryCount());
+  EXPECT_EQ(0, reload_observer.load_count());
+}
