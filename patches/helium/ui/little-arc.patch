+IN_PROC_BROWSER_TEST_F(AppControllerLittleArcBrowserTest,
+                       ExternalWebUrlUsesSameProfilePreview) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  const size_t windows = GlobalBrowserCollection::GetInstance()->GetSize();
+  const int tabs = browser()->GetTabStripModel()->count();
+  SendOpenUrlToAppController(url);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    BrowserWindowInterface* active =
+        GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+    return GlobalBrowserCollection::GetInstance()->GetSize() == windows + 1 &&
+           active && active->GetType() == BrowserWindowInterface::TYPE_POPUP;
+  }));
+  BrowserWindowInterface* popup =
+      GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  ASSERT_TRUE(popup);
+  ASSERT_EQ(BrowserWindowInterface::TYPE_POPUP, popup->GetType());
+  EXPECT_EQ(browser()->GetProfile(), popup->GetProfile());
+  EXPECT_EQ(tabs, browser()->GetTabStripModel()->count());
+  content::WebContents* contents =
+      popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(url, contents->GetLastCommittedURL());
+  chrome::ExecuteCommand(popup, IDC_SHOW_AS_TAB);
+  EXPECT_EQ(contents, browser()->GetTabStripModel()->GetActiveWebContents());
+}
