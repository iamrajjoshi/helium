+  ConvertPopupToTabbedBrowser(popup);
+  BrowserWindowInterface* target =
+      ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser();
+  ASSERT_TRUE(target);
+  EXPECT_EQ(profile, target->GetProfile());
+  EXPECT_EQ(contents, target->GetTabStripModel()->GetActiveWebContents());
+  EXPECT_FALSE(browser_shutdown::HasShutdownStarted());
+}
