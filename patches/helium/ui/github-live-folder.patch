+
+// Repository identity is ASCII case-insensitive on GitHub. The spelling from
+// the original URL is retained for display and for generated URLs.
+struct GitHubRepository {
+  std::string owner;
+  std::string name;
+
+  std::string Key() const;
+  // These return an empty string for invalid repository fields. ApiUrl requests
+  // only the 10 most recently updated open pull requests, with no pagination.
+  std::string ApiUrl() const;
+  // Pull-request numbers must be in the positive range of int.
+  std::string PullUrl(int number) const;
+
+  bool operator==(const GitHubRepository& other) const;
+  bool operator!=(const GitHubRepository& other) const;
+};
+
+// Accepts only the literal https://github.com origin: no credentials, port,
+// escaped host, subdomain, or case/scheme normalization. Owner and repository
+// segments must be unescaped ASCII GitHub names. A path/query/fragment after
+// the repository is ignored. Raw whitespace, controls, and backslashes are
+// rejected throughout the URL to avoid browser/parser interpretation mismatch.
+std::optional<GitHubRepository> ParseGitHubRepositoryUrl(std::string_view url);
+
+// Accepts only https://github.com/{owner}/{repo}/pull/{number}, allowing ASCII
+// case differences in owner/repo only. Rejects padding, signs, suffixes,
+// queries, fragments, encoded names, and any other origin or path.
+bool IsExpectedGitHubPullUrl(const GitHubRepository& repository,
+                             int number,
+                             std::string_view url);
+
+// Sequence-affine guard for asynchronous refresh responses. Only the latest
+// nonzero generation is current. Stop permanently invalidates all generations;
+// subsequent Begin calls return 0 and cannot reactivate the guard. Overflow
+// also stops the guard rather than ever reusing a token.
+class GitHubLiveFolderRefreshGuard {
+ public:
+  std::uint64_t Begin();
+  bool IsCurrent(std::uint64_t generation) const;
+  void Stop();
+
+ private:
+  std::uint64_t generation_ = 0;
+  bool stopped_ = false;
+};
+
