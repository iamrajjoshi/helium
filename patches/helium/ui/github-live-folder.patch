+struct GitHubLiveFolderController::Folder {
+  Folder(tab_groups::TabGroupId group_id, GitHubRepository repo)
+      : group(group_id), repository(std::move(repo)) {}
+  ~Folder() = default;
+
+  const tab_groups::TabGroupId group;
+  const GitHubRepository repository;
+  bool live = true;
+  GitHubLiveFolderRefreshGuard refresh_guard;
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  base::TimeTicks last_request;
+  base::TimeTicks retry_after;
+  std::u16string last_title;
+  std::map<int, base::WeakPtr<tabs::TabInterface>> tabs;
+  // Count every still-open tab this folder created, including tabs preserved
+  // outside the group or moved to another window. Never close them to free space.
+  struct CreatedTab {
+    base::WeakPtr<tabs::TabInterface> tab;
+    base::WeakPtr<content::WebContents> contents;
+  };
+  // Page identity survives moves that recreate TabInterface. Keep the tab
+  // identity too, so discarding/replacing WebContents does not free a slot.
+  std::vector<CreatedTab> created_tabs;
+  // Reserve before notifying insertion. If an observer moves a newly created
+  // tab out of this model before we can identify it, keep the slot occupied.
+  size_t reserved_tab_slots = 0;
+  // A tab the user closed, navigated, or moved is not reopened on every poll.
+  // This is pruned against each valid snapshot, keeping it bounded to the snapshot size.
+  std::set<int> dismissed;
+};
+
+GitHubLiveFolderController::GitHubLiveFolderController(TabStripModel* model)
+    : GitHubLiveFolderController(model, nullptr) {}
+
+GitHubLiveFolderController::GitHubLiveFolderController(
+    TabStripModel* model,
+    scoped_refptr<network::SharedURLLoaderFactory> factory)
+    : model_(model), factory_(std::move(factory)) {
+  CHECK(model_);
+  observation_.Observe(model_);
+}
+
+GitHubLiveFolderController::~GitHubLiveFolderController() = default;
+
+// static
+bool GitHubLiveFolderController::CanCreateForTab(const TabStripModel* model,
+                                                int index) {
+  return model->ContainsIndex(index) && !model->closing_all() &&
+         model->SupportsTabGroups() && !model->profile()->IsOffTheRecord() &&
+         !model->profile()->IsGuestSession() &&
+         !model->delegate()->IsForWebApp() && !model->IsTabPinned(index) &&
+         !model->GetSplitForTab(index) && !model->GetTabGroupForTab(index) &&
+         ParseGitHubRepositoryUrl(
+             model->GetWebContentsAt(index)->GetLastCommittedURL().spec())
+             .has_value();
+}
+
+bool GitHubLiveFolderController::CanCreate(int index) const {
+  if (!CanCreateForTab(model_, index)) {
+    return false;
+  }
+  const auto repository = ParseGitHubRepositoryUrl(
+      model_->GetWebContentsAt(index)->GetLastCommittedURL().spec());
+  size_t live_count = 0;
+  for (const auto& [group, folder] : folders_) {
+    if (folder->live && GroupExists(group)) {
+      ++live_count;
+      if (folder->repository == *repository) {
+        return false;
+      }
+    }
+  }
+  return live_count < kMaximumFoldersPerWindow;
+}
+
+GitHubLiveFolderController::Folder*
+GitHubLiveFolderController::GetFolderAt(int index) const {
+  if (!model_->ContainsIndex(index)) {
+    return nullptr;
+  }
+  const auto group = model_->GetTabGroupForTab(index);
+  if (!group) {
+    return nullptr;
+  }
+  auto it = folders_.find(*group);
+  return it != folders_.end() && it->second->live ? it->second.get() : nullptr;
+}
+
+bool GitHubLiveFolderController::HasFolderAt(int index) const {
+  return GetFolderAt(index) != nullptr;
+}
+
+bool GitHubLiveFolderController::CanRefreshAt(int index) const {
+  const Folder* folder = GetFolderAt(index);
+  const auto now = base::TimeTicks::Now();
+  return folder && !folder->loader && !model_->closing_all() &&
+         now >= folder->retry_after &&
+         now - folder->last_request >= kManualRefreshCooldown;
+}
+
+bool GitHubLiveFolderController::GroupExists(
+    const tab_groups::TabGroupId& group) const {
+  return model_->group_model() &&
+         model_->group_model()->ContainsTabGroup(group);
+}
+
+void GitHubLiveFolderController::Create(int index) {
+  if (!CanCreate(index)) {
+    return;
+  }
+  std::erase_if(folders_, [](const auto& item) { return !item.second->live; });
+  auto repository = ParseGitHubRepositoryUrl(
+      model_->GetWebContentsAt(index)->GetLastCommittedURL().spec());
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  const auto group = model_->AddToNewGroup({index});
+  if (!weak_this || !GroupExists(group) || model_->closing_all()) {
+    return;
+  }
+  auto folder = std::make_shared<Folder>(group, std::move(*repository));
+  folder->last_title = model_->group_model()
+                           ->GetTabGroup(group)
+                           ->visual_data()
+                           ->title();
+  folders_.emplace(group, folder);
+  Refresh(group);
+  if (!weak_this || !folder->live || !GroupExists(group)) {
+    return;
+  }
+  if (!timer_.IsRunning()) {
+    timer_.Start(FROM_HERE, kRefreshInterval, this,
+                 &GitHubLiveFolderController::RefreshAll);
+  }
+}
+
+void GitHubLiveFolderController::RefreshAt(int index) {
+  if (CanRefreshAt(index)) {
+    const auto group = GetFolderAt(index)->group;
+    Refresh(group);
+  }
+}
+
+void GitHubLiveFolderController::StopAt(int index) {
+  if (Folder* folder = GetFolderAt(index)) {
+    // Keep state alive even if a synchronous observer starts a new folder and
+    // prunes this stopped entry while the title notification is dispatched.
+    const auto retained_folder = folders_.at(folder->group);
+    Cancel(*retained_folder);
+    StopTimerIfIdle();
+    SetStatus(*retained_folder, "stopped");
+  }
+}
+
+void GitHubLiveFolderController::Cancel(Folder& folder) {
+  folder.live = false;
+  folder.refresh_guard.Stop();
+  folder.loader.reset();
+}
+
+void GitHubLiveFolderController::StopTimerIfIdle() {
+  if (std::ranges::none_of(folders_, [](const auto& item) {
+        return item.second->live;
+      })) {
+    timer_.Stop();
+  }
+}
+
+void GitHubLiveFolderController::OnTabGroupChanged(
+    const TabGroupChange& change) {
+  if (change.type != TabGroupChange::kClosed) {
+    return;
+  }
+  auto it = folders_.find(change.group);
+  if (it != folders_.end()) {
+    // Do not erase synchronously: removing the final owned tab during a
+    // snapshot can close a group and re-enter this observer.
+    Cancel(*it->second);
+    StopTimerIfIdle();
+  }
+}
+
+void GitHubLiveFolderController::RefreshAll() {
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  std::vector<tab_groups::TabGroupId> groups;
+  for (const auto& [group, folder] : folders_) {
+    groups.push_back(group);
+  }
+  for (const auto& group : groups) {
+    const auto it = folders_.find(group);
+    if (it == folders_.end()) {
+      continue;
+    }
+    const auto folder = it->second;
+    if (!folder->live) {
+      continue;
+    }
+    if (!GroupExists(group)) {
+      Cancel(*folder);
+    } else if (!folder->loader &&
+               base::TimeTicks::Now() >= folder->retry_after &&
+               base::TimeTicks::Now() - folder->last_request >=
+                   kRefreshInterval) {
+      Refresh(group);
+      if (!weak_this) {
+        return;
+      }
+    }
+  }
+  StopTimerIfIdle();
+}
+
+void GitHubLiveFolderController::Refresh(
+    const tab_groups::TabGroupId& group) {
+  auto it = folders_.find(group);
+  if (it == folders_.end() || !it->second->live ||
+      !GroupExists(group) || model_->closing_all()) {
+    return;
+  }
+  const auto retained_folder = it->second;
+  Folder& folder = *retained_folder;
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  folder.loader.reset();
+  const uint64_t generation = folder.refresh_guard.Begin();
+  folder.last_request = base::TimeTicks::Now();
+  SetStatus(folder, "refreshing");
+  if (!weak_this || !folder.live ||
+      !folder.refresh_guard.IsCurrent(generation) || !GroupExists(group) ||
+      model_->closing_all()) {
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(folder.repository.ApiUrl());
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->load_flags = net::LOAD_BYPASS_CACHE | net::LOAD_DISABLE_CACHE;
+  request->headers.SetHeader("Accept", "application/vnd.github+json");
+  request->headers.SetHeader("X-GitHub-Api-Version", "2022-11-28");
+
+  constexpr auto annotation = net::DefineNetworkTrafficAnnotation(
+      "helium_github_live_folder", R"(
+        semantics {
+          sender: "Helium GitHub Live Folder"
+          description: "Reads the latest 10 open pull requests for a public "
+                       "GitHub repository chosen by the user and updates "
+                       "a native tab group. No authentication is used."
+          trigger: "Explicit Create GitHub live folder or Refresh action, "
+                   "then once per five minutes while the live group exists."
+          data: "The repository owner/name selected by the user."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Disabled by default. Stop GitHub live folder, remove "
+                   "the group, or close the window to stop requests. "
+                   "Live state is not restored after restarting."
+          policy_exception_justification: "This opt-in personal-fork feature "
+                                          "has no enterprise policy."
+        })");
+  folder.loader =
+      network::SimpleURLLoader::Create(std::move(request), annotation);
+  folder.loader->SetTimeoutDuration(base::Seconds(30));
+  if (!factory_) {
+    factory_ = model_->profile()
+                   ->GetDefaultStoragePartition()
+                   ->GetURLLoaderFactoryForBrowserProcess();
+  }
+  folder.loader->DownloadToString(
+      factory_.get(),
+      base::BindOnce(&GitHubLiveFolderController::OnResponse,
+                     weak_factory_.GetWeakPtr(), group, generation),
+      kMaximumResponseBytes);
+}
+
+void GitHubLiveFolderController::SetStatus(Folder& folder,
+                                          const std::string& status) {
+  if (!GroupExists(folder.group)) {
+    return;
+  }
+  auto* group = model_->group_model()->GetTabGroup(folder.group);
+  const auto* data = group->visual_data();
+  // Preserve an explicitly customized name, color, and collapsed state.
+  if (data->title() != folder.last_title) {
+    return;
+  }
+  folder.last_title = base::UTF8ToUTF16(
+      "GitHub: " + folder.repository.Key() + " [" + status + "]");
+  auto new_data = tab_groups::TabGroupVisualData(
+      folder.last_title, data->color(), data->is_collapsed());
+  model_->ChangeTabGroupVisuals(folder.group, std::move(new_data), false);
+}
+
+void GitHubLiveFolderController::OnResponse(
+    const tab_groups::TabGroupId& group,
+    uint64_t generation,
+    std::optional<std::string> body) {
+  auto it = folders_.find(group);
+  if (it == folders_.end() || !it->second->live ||
+      !it->second->refresh_guard.IsCurrent(generation) ||
+      !GroupExists(group) || model_->closing_all()) {
+    return;
+  }
+  const auto retained_folder = it->second;
+  Folder& folder = *retained_folder;
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  CHECK(folder.loader);
+  const auto* info = folder.loader->ResponseInfo();
+  const int status = info && info->headers ? info->headers->response_code() : 0;
+  const bool success = folder.loader->NetError() == net::OK && status == 200;
+  folder.loader.reset();
+
+  if (!success || !body) {
+    if (status == 403 || status == 429) {
+      folder.retry_after = base::TimeTicks::Now() + base::Hours(1);
+      SetStatus(folder, "rate limited; retry in 1 hour");
+    } else if (status == 401 || status == 404 ||
+               (status >= 300 && status < 400)) {
+      folder.retry_after = base::TimeTicks::Now() + base::Minutes(30);
+      SetStatus(folder, "unavailable; public repositories only");
+    } else {
+      SetStatus(folder, "refresh failed; keeping tabs");
+    }
+    return;
+  }
+  const auto numbers = ParsePullRequests(folder.repository, *body);
+  if (!numbers) {
+    SetStatus(folder, "invalid response; keeping tabs");
+    return;
+  }
+
+  const std::set<int> wanted(numbers->begin(), numbers->end());
+  std::vector<int> ungroup;
+  for (auto owned = folder.tabs.begin(); owned != folder.tabs.end();) {
+    auto* tab = owned->second.get();
+    const int index = tab ? model_->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (!tab || !model_->ContainsIndex(index) ||
+        model_->GetTabGroupForTab(index) != group ||
+        model_->GetSplitForTab(index).has_value() ||
+        !IsExpectedGitHubPullUrl(folder.repository, owned->first,
+                                tab->GetContents()->GetVisibleURL().spec())) {
+      folder.dismissed.insert(owned->first);
+      owned = folder.tabs.erase(owned);
+    } else if (!wanted.contains(owned->first)) {
+      ungroup.push_back(index);
+      owned = folder.tabs.erase(owned);
+    } else {
+      ++owned;
+    }
+  }
+  std::erase_if(folder.dismissed,
+                [&](int number) { return !wanted.contains(number); });
+  if (!ungroup.empty()) {
+    std::ranges::sort(ungroup);
+    // Never close a tab: the user may have a draft comment or other state in it.
+    model_->RemoveFromGroup(ungroup);
+    if (!weak_this) {
+      return;
+    }
+  }
+  if (!folder.live || !folder.refresh_guard.IsCurrent(generation) ||
+      !GroupExists(group) || model_->closing_all()) {
+    return;
+  }
+
+  for (auto& created : folder.created_tabs) {
+    if (created.tab) {
+      created.contents = created.tab->GetContents()->GetWeakPtr();
+    }
+  }
+  std::erase_if(folder.created_tabs, [](const auto& created) {
+    return !created.tab && !created.contents;
+  });
+  bool tab_limit_reached = false;
+  for (int number : *numbers) {
+    if (folder.tabs.contains(number) || folder.dismissed.contains(number)) {
+      continue;
+    }
+    bool already_open = false;
+    // Check the whole window: a PR may have left the top-ten snapshot and
+    // been preserved outside the group, or already be open in a user's tab.
+    for (int index = 0; index < model_->count(); ++index) {
+      if (IsExpectedGitHubPullUrl(
+              folder.repository, number,
+              model_->GetWebContentsAt(index)->GetVisibleURL().spec())) {
+        already_open = true;
+        break;
+      }
+    }
+    if (already_open) {
+      // Do not take ownership of a pre-existing tab the user added themselves.
+      folder.dismissed.insert(number);
+      continue;
+    }
+    if (folder.created_tabs.size() + folder.reserved_tab_slots >=
+        kGitHubLiveFolderMaxPullRequests) {
+      tab_limit_reached = true;
+      continue;
+    }
+    const auto range = model_->group_model()->GetTabGroup(group)->ListTabs();
+    const int insertion_index = range.end();
+    std::vector<base::WeakPtr<content::WebContents>> previous_contents;
+    for (int index = 0; index < model_->count(); ++index) {
+      previous_contents.push_back(model_->GetWebContentsAt(index)->GetWeakPtr());
+    }
+    ++folder.reserved_tab_slots;
+    model_->delegate()->AddTabAt(
+        GURL(folder.repository.PullUrl(number)), insertion_index, false, group,
+        model_->IsTabPinned(range.start()));
+    if (!weak_this) {
+      return;
+    }
+    if (!folder.live || !folder.refresh_guard.IsCurrent(generation) ||
+        !GroupExists(group) || model_->closing_all()) {
+      return;
+    }
+    for (int index = 0; index < model_->count(); ++index) {
+      auto* tab = model_->GetTabAtIndex(index);
+      if (std::ranges::any_of(previous_contents, [tab](const auto& previous) {
+            return previous.get() == tab->GetContents();
+          }) ||
+          !IsExpectedGitHubPullUrl(folder.repository, number,
+                                  tab->GetContents()->GetVisibleURL().spec())) {
+        continue;
+      }
+      --folder.reserved_tab_slots;
+      folder.created_tabs.push_back(
+          {tab->GetWeakPtr(), tab->GetContents()->GetWeakPtr()});
+      if (model_->GetTabGroupForTab(index) == group) {
+        folder.tabs[number] = tab->GetWeakPtr();
+      } else {
+        folder.dismissed.insert(number);
+      }
+      break;
+    }
+  }
+  folder.retry_after = base::TimeTicks();
+  SetStatus(folder, base::NumberToString(numbers->size()) +
+                        (numbers->size() == kGitHubLiveFolderMaxPullRequests
+                             ? " latest open PRs"
+                             : " open PRs") +
+                        (tab_limit_reached ? "; tab limit reached" : ""));
+}
