+constexpr size_t kMaximumFoldersPerWindow = 3;
+constexpr size_t kMaximumResponseBytes = 1024 * 1024;
+constexpr base::TimeDelta kRefreshInterval = base::Minutes(5);
+constexpr base::TimeDelta kManualRefreshCooldown = base::Minutes(1);
+
+// Reject the entire response on malformed entries: a partial/error response
+// must never be interpreted as evidence that existing PRs disappeared.
+std::optional<std::vector<int>> ParsePullRequests(
+    const GitHubRepository& repository,
+    const std::string& body) {
+  auto parsed = base::JSONReader::Read(body, base::JSON_PARSE_RFC, 32);
+  if (!parsed || !parsed->is_list() ||
+      parsed->GetList().size() > kGitHubLiveFolderMaxPullRequests) {
+    return std::nullopt;
+  }
+  std::set<int> seen;
+  std::vector<int> numbers;
+  for (const auto& value : parsed->GetList()) {
+    if (!value.is_dict()) {
+      return std::nullopt;
+    }
+    const auto& entry = value.GetDict();
+    const auto number = entry.FindInt("number");
+    const auto* state = entry.FindString("state");
+    const auto* url = entry.FindString("html_url");
+    if (!number || !state || *state != "open" || !url ||
+        !IsExpectedGitHubPullUrl(repository, *number, *url) ||
+        !seen.insert(*number).second) {
+      return std::nullopt;
+    }
+    numbers.push_back(*number);
+  }
+  return numbers;
+}
+
+}  // namespace
