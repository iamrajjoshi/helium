+// An opt-in, window-scoped native tab-group controller. It is never constructed
+// by startup/session restore, never authenticates to GitHub, and never closes
+// tabs. Moving its group to another window stops refresh in the source window.
+class GitHubLiveFolderController : public TabStripModelObserver {
+ public:
+  explicit GitHubLiveFolderController(TabStripModel* model);
+  GitHubLiveFolderController(
+      TabStripModel* model,
+      scoped_refptr<network::SharedURLLoaderFactory> factory);
+  ~GitHubLiveFolderController() override;
+
+  static bool CanCreateForTab(const TabStripModel* model, int index);
+  bool CanCreate(int index) const;
+  bool HasFolderAt(int index) const;
+  bool CanRefreshAt(int index) const;
+  void Create(int index);
+  void RefreshAt(int index);
+  void StopAt(int index);
+
+  // TabStripModelObserver:
+  void OnTabGroupChanged(const TabGroupChange& change) override;
+
+ private:
+  struct Folder;
+  Folder* GetFolderAt(int index) const;
+  bool GroupExists(const tab_groups::TabGroupId& group) const;
+  void RefreshAll();
+  void Refresh(const tab_groups::TabGroupId& group);
+  void OnResponse(const tab_groups::TabGroupId& group,
+                  uint64_t generation,
