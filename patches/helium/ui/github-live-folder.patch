+constexpr std::string_view kWebOrigin = "https://github.com/";
+
+bool IsAsciiAlphanumeric(char value) {
+  return (value >= 'a' && value <= 'z') ||
+         (value >= 'A' && value <= 'Z') ||
+         (value >= '0' && value <= '9');
+}
+
+char ToLowerAscii(char value) {
+  return value >= 'A' && value <= 'Z' ? value + ('a' - 'A') : value;
+}
+
+bool EqualIgnoringAsciiCase(std::string_view a, std::string_view b) {
+  if (a.size() != b.size()) {
+    return false;
+  }
+  for (std::size_t i = 0; i < a.size(); ++i) {
+    if (ToLowerAscii(a[i]) != ToLowerAscii(b[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsValidOwner(std::string_view owner) {
+  if (owner.empty() || owner.size() > 39 ||
+      !IsAsciiAlphanumeric(owner.front()) ||
+      !IsAsciiAlphanumeric(owner.back())) {
+    return false;
+  }
+  bool previous_was_hyphen = false;
+  for (const char value : owner) {
+    if (!IsAsciiAlphanumeric(value) && value != '-') {
+      return false;
+    }
+    if (value == '-' && previous_was_hyphen) {
+      return false;
+    }
+    previous_was_hyphen = value == '-';
+  }
+  return true;
+}
+
+bool IsValidRepositoryName(std::string_view name) {
+  if (name.empty() || name.size() > 100 || name == "." || name == "..") {
+    return false;
+  }
+  for (const char value : name) {
+    if (!IsAsciiAlphanumeric(value) && value != '-' && value != '.' &&
+        value != '_') {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsValidRepository(const GitHubRepository& repository) {
+  return IsValidOwner(repository.owner) &&
+         IsValidRepositoryName(repository.name);
+}
+
+bool HasUnsafeUrlCharacter(std::string_view url) {
+  for (const unsigned char value : url) {
+    // DEL is a control character too. Non-ASCII owner/repo bytes are separately
+    // rejected by their allowlists. URL suffixes are never used for requests.
+    if (value <= 0x20 || value == 0x7f || value == '\\') {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+std::string GitHubRepository::Key() const {
+  std::string result = owner + "/" + name;
+  for (char& value : result) {
+    value = ToLowerAscii(value);
+  }
+  return result;
+}
+
+std::string GitHubRepository::ApiUrl() const {
+  if (!IsValidRepository(*this)) {
+    return {};
+  }
+  return "https://api.github.com/repos/" + owner + "/" + name +
+         "/pulls?state=open&sort=updated&direction=desc&per_page=" +
+         std::to_string(kGitHubLiveFolderMaxPullRequests);
+}
+
+std::string GitHubRepository::PullUrl(int number) const {
+  if (number <= 0 || !IsValidRepository(*this)) {
+    return {};
+  }
+  return std::string(kWebOrigin) + owner + "/" + name + "/pull/" +
+         std::to_string(number);
+}
+
+bool GitHubRepository::operator==(const GitHubRepository& other) const {
+  return EqualIgnoringAsciiCase(owner, other.owner) &&
+         EqualIgnoringAsciiCase(name, other.name);
+}
+
+bool GitHubRepository::operator!=(const GitHubRepository& other) const {
+  return !(*this == other);
+}
+
+std::optional<GitHubRepository> ParseGitHubRepositoryUrl(std::string_view url) {
+  if (url.substr(0, kWebOrigin.size()) != kWebOrigin ||
+      HasUnsafeUrlCharacter(url)) {
+    return std::nullopt;
+  }
+  url.remove_prefix(kWebOrigin.size());
+  const std::size_t owner_end = url.find_first_of("/?#");
+  if (owner_end == std::string_view::npos || url[owner_end] != '/') {
+    return std::nullopt;
+  }
+  const std::string_view owner = url.substr(0, owner_end);
+  url.remove_prefix(owner_end + 1);
+  const std::string_view name = url.substr(0, url.find_first_of("/?#"));
+  if (!IsValidOwner(owner) || !IsValidRepositoryName(name)) {
+    return std::nullopt;
+  }
+  return GitHubRepository{std::string(owner), std::string(name)};
+}
+
+bool IsExpectedGitHubPullUrl(const GitHubRepository& repository,
+                             int number,
+                             std::string_view url) {
+  if (number <= 0 || !IsValidRepository(repository)) {
+    return false;
+  }
+  const auto parsed = ParseGitHubRepositoryUrl(url);
+  return parsed && *parsed == repository && url == parsed->PullUrl(number);
+}
+
+std::uint64_t GitHubLiveFolderRefreshGuard::Begin() {
+  if (stopped_) {
+    return 0;
+  }
+  if (generation_ == std::numeric_limits<std::uint64_t>::max()) {
+    Stop();
+    return 0;
+  }
+  return ++generation_;
+}
+
+bool GitHubLiveFolderRefreshGuard::IsCurrent(std::uint64_t generation) const {
+  return !stopped_ && generation != 0 && generation == generation_;
+}
+
+void GitHubLiveFolderRefreshGuard::Stop() {
+  stopped_ = true;
+}
