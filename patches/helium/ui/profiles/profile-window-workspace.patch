+// Real browser/profile integration tests for the personal-fork workspace swap.
+// These require the compiled browser_tests target, not a mock BrowserWindow.
+class ProfileMenuViewWorkspaceTest : public ProfileMenuViewBrowserTest {
+ public:
+  ProfileMenuViewWorkspaceTest() {
+    features_.InitFromCommandLine("HeliumProfileWindowSwitching", "");
+  }
+
+ protected:
+  void SelectProfile(BrowserWindowInterface* from, Profile* to) {
+    SetTargetBrowser(from);
+    OpenProfileMenu(from);
+    auto* menu = static_cast<ProfileMenuView*>(profile_menu_view());
+    ASSERT_TRUE(menu);
+    menu->set_skip_window_active_check_for_testing(true);
+    menu->OnOtherProfileSelected(to->GetPath());
+  }
+
+ private:
+  base::test::ScopedFeatureList features_;
+};
+
+IN_PROC_BROWSER_TEST_F(ProfileMenuViewWorkspaceTest,
+                       KeepsStorageAndLiveTabsIsolated) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  auto* first = browser();
+  Profile* second_profile = CreateAdditionalProfile();
+  auto* second = CreateBrowser(second_profile);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(first, url));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(second, url));
+  auto* first_tab = first->GetTabStripModel()->GetActiveWebContents();
+  auto* second_tab = second->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(first_tab,
+      "document.cookie='workspace=first';localStorage.key='first';"
+      "window.unsaved='first draft'"));
+  ASSERT_TRUE(content::ExecJs(second_tab,
+      "document.cookie='workspace=second';localStorage.key='second';"
+      "window.unsaved='second draft'"));
+  first->GetWindow()->Restore();
+  first->GetWindow()->SetBounds(gfx::Rect(100, 100, 900, 700));
+  first->GetWindow()->Show();
+  const gfx::Rect bounds = first->GetWindow()->GetRestoredBounds();
+
+  for (int i = 0; i < 3; ++i) {
+    SelectProfile(first, second_profile);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return !first->GetWindow()->IsVisible() &&
+             second->GetWindow()->IsVisible();
+    }));
+    EXPECT_EQ(bounds, second->GetWindow()->GetRestoredBounds());
+    EXPECT_EQ(second_profile, second->GetProfile());
+    EXPECT_EQ(second_tab, second->GetTabStripModel()->GetActiveWebContents());
+    EXPECT_EQ("workspace=second", content::EvalJs(second_tab, "document.cookie"));
+    EXPECT_EQ("second", content::EvalJs(second_tab, "localStorage.key"));
+    EXPECT_EQ("second draft", content::EvalJs(second_tab, "window.unsaved"));
+
+    SelectProfile(second, first->GetProfile());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return first->GetWindow()->IsVisible() &&
+             !second->GetWindow()->IsVisible();
+    }));
+    EXPECT_EQ(first_tab, first->GetTabStripModel()->GetActiveWebContents());
+    EXPECT_EQ("workspace=first", content::EvalJs(first_tab, "document.cookie"));
+    EXPECT_EQ("first", content::EvalJs(first_tab, "localStorage.key"));
+    EXPECT_EQ("first draft", content::EvalJs(first_tab, "window.unsaved"));
+  }
+  SelectProfile(first, second_profile);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !first->GetWindow()->IsVisible(); }));
+  CloseBrowserSynchronously(second);
+  EXPECT_TRUE(first->GetWindow()->IsVisible());
+  SetTargetBrowser(first);
+}
+
+IN_PROC_BROWSER_TEST_F(ProfileMenuViewWorkspaceTest,
+                       CreatesTargetAndRestoresPreviousOnClose) {
+  auto* first = browser();
+  Profile* second_profile = CreateAdditionalProfile();
+  SelectProfile(first, second_profile);
+  BrowserWindowInterface* second = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    second = ProfileBrowserCollection::GetForProfile(second_profile)
+                 ->FindTabbedBrowser(/*match_original_profiles=*/false);
+    return second && second->GetWindow()->IsVisible();
+  }));
+  // Initial WebUI paint can defer Show(). The safe first-open fallback leaves
+  // the source visible; selecting the now-ready target must swap it normally.
+  if (first->GetWindow()->IsVisible()) {
+    first->GetWindow()->Show();
+    SelectProfile(first, second_profile);
+  }
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !first->GetWindow()->IsVisible(); }));
+  EXPECT_EQ(second_profile, second->GetProfile());
+  second->GetWindow()->Close();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return first->GetWindow()->IsVisible(); }));
+  SetTargetBrowser(first);
+}
+
+IN_PROC_BROWSER_TEST_F(ProfileMenuViewWorkspaceTest,
+                       ThreeProfilesRestoreInOrderWithoutMovingTabs) {
+  auto* first = browser();
+  Profile* second_profile = CreateAdditionalProfile();
+  Profile* third_profile = CreateAdditionalProfile();
+  auto* second = CreateBrowser(second_profile);
+  auto* third = CreateBrowser(third_profile);
+  first->GetWindow()->Show();
+  SelectProfile(first, second_profile);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !first->GetWindow()->IsVisible(); }));
+  SelectProfile(second, third_profile);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !second->GetWindow()->IsVisible(); }));
+  EXPECT_EQ(second_profile, second->GetProfile());
+  EXPECT_EQ(third_profile, third->GetProfile());
+  CloseBrowserSynchronously(third);
+  EXPECT_TRUE(second->GetWindow()->IsVisible());
+  EXPECT_FALSE(first->GetWindow()->IsVisible());
+  CloseBrowserSynchronously(second);
+  EXPECT_TRUE(first->GetWindow()->IsVisible());
+  SetTargetBrowser(first);
+}
