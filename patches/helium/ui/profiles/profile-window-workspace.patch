+// Personal-fork workspace switching. Browser windows and their WebContents
+// always retain their original Profile; no storage or tabs cross profiles.
+class ProfileWindowWorkspace : public BrowserCollectionObserver {
+ public:
+  static ProfileWindowWorkspace& Get() {
+    static base::NoDestructor<ProfileWindowWorkspace> instance;
+    return *instance;
+  }
+
+  void SwitchProfile(BrowserWindowInterface& source,
+                     const base::FilePath& path) {
+    if (!observation_.IsObserving()) {
+      observation_.Observe(GlobalBrowserCollection::GetInstance());
+    }
+    const unsigned request = ++request_;
+    profiles::LoadProfileAsync(
+        path, base::BindOnce(&ProfileWindowWorkspace::OnProfileLoaded,
+                            base::Unretained(this), request, source.GetWeakPtr(),
+                            source.GetWindow()->GetRestoredBounds(),
+                            source.GetWindow()->IsMaximized()));
+  }
+
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    // The collection removes the closing browser before notifying observers.
+    // Detach before its owning browser-process features are destroyed, and
+    // allow a later browser-process/test instance to attach afresh.
+    if (GlobalBrowserCollection::GetInstance()->IsEmpty()) {
+      ++request_;
+      active_ = nullptr;
+      hidden_.clear();
+      observation_.Reset();
+      return;
+    }
+    RemoveHidden(browser);
+    if (active_ != browser) {
+      return;
+    }
+    active_ = nullptr;
+    // Quitting must close all profiles, not resurrect hidden windows.
+    if (browser_shutdown::IsTryingToQuit()) {
+      hidden_.clear();
+      return;
+    }
+    while (!hidden_.empty()) {
+      auto previous = hidden_.back();
+      hidden_.pop_back();
+      if (previous && !previous->IsDeleteScheduled() && previous->GetWindow()) {
+        active_ = previous.get();
+        previous->GetWindow()->Show();
+        return;
+      }
+    }
+  }
+
+ private:
+  friend class base::NoDestructor<ProfileWindowWorkspace>;
+  ProfileWindowWorkspace() = default;
+
+  void RemoveHidden(BrowserWindowInterface* browser) {
+    std::erase_if(hidden_, [browser](const auto& entry) {
+      return !entry || entry.get() == browser;
+    });
+  }
+
+  void OnProfileLoaded(unsigned request,
+                       base::WeakPtr<BrowserWindowInterface> source,
+                       const gfx::Rect& bounds,
+                       bool maximized,
+                       Profile* profile) {
+    // Check before the helper activates/creates a window, not just afterward:
+    // a late profile load must not steal focus from a newer selection.
+    if (request != request_ || !source || source->IsDeleteScheduled() ||
+        !profile || browser_shutdown::IsTryingToQuit()) {
+      return;
+    }
+    profiles::OpenBrowserWindowForProfile(
+        base::BindOnce(&ProfileWindowWorkspace::CompleteSwitch,
+                       base::Unretained(this), request, source, bounds, maximized),
+        /*always_create=*/false, /*is_new_profile=*/false,
+        /*open_command_line_urls=*/false, profile);
+  }
+
+  void CompleteSwitch(unsigned request,
+                      base::WeakPtr<BrowserWindowInterface> source,
+                      const gfx::Rect& bounds,
+                      bool maximized,
+                      BrowserWindowInterface* target) {
+    auto target_weak = target ? target->GetWeakPtr()
+                              : base::WeakPtr<BrowserWindowInterface>();
+    // Native Show/Restore/resize can reenter and close either window. Never
+    // carry raw window pointers across those calls.
+    const auto windows_valid = [&] {
+      return request == request_ && source && target_weak &&
+             source.get() != target_weak.get() &&
+             !source->IsDeleteScheduled() && !target_weak->IsDeleteScheduled() &&
+             !browser_shutdown::IsTryingToQuit() && source->GetWindow() &&
+             target_weak->GetWindow();
+    };
+    if (!windows_valid()) {
+      return;
+    }
+    // Native fullscreen/Spaces transitions cannot safely be imitated with
+    // bounds. Preserve Chromium's ordinary switch behavior in that case.
+    if (source->GetWindow()->IsFullscreen() ||
+        target_weak->GetWindow()->IsFullscreen()) {
+      target_weak->GetWindow()->Show();
+      return;
+    }
+    target_weak->GetWindow()->Restore();
+    if (!windows_valid()) {
+      return;
+    }
+    target_weak->GetWindow()->SetBounds(bounds);
+    if (!windows_valid()) {
+      return;
+    }
+    if (maximized) {
+      target_weak->GetWindow()->Maximize();
+      if (!windows_valid()) {
+        return;
+      }
+    }
+    // Show may defer for initial WebUI paint. Keep the source visible in that
+    // case rather than leaving the user without any visible browser window.
+    target_weak->GetWindow()->Show();
+    if (!windows_valid() || !target_weak->GetWindow()->IsVisible()) {
+      return;
+    }
+    RemoveHidden(target_weak.get());
+    RemoveHidden(source.get());
+    hidden_.push_back(source);
+    active_ = target_weak.get();
+    source->GetWindow()->Hide();
+    if (source && source->GetWindow() && source->GetWindow()->IsVisible()) {
+      RemoveHidden(source.get());
+    }
+  }
+
+  unsigned request_ = 0;
+  raw_ptr<BrowserWindowInterface> active_ = nullptr;
+  std::vector<base::WeakPtr<BrowserWindowInterface>> hidden_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      observation_{this};
+};
